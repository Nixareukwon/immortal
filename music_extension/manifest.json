{
  "manifest_version": 3,
  "name": "Immortal · Music only",
  "version": "1.0.0",
  "description": "Передаёт название и обложку только из музыкальных сервисов в локальный виджет Immortal.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://*.scdn.co/*", "https://*.yandex.net/*", "https://*.ytimg.com/*", "https://*.googleusercontent.com/*"],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html",
  "action": {"default_popup": "options.html"},
  "content_scripts": [
    {"matches": ["https://open.spotify.com/*", "https://music.yandex.ru/*", "https://music.yandex.com/*", "https://music.yandex.kz/*", "https://music.yandex.by/*", "https://music.youtube.com/*"], "js": ["media.js"], "world": "MAIN"},
    {"matches": ["https://open.spotify.com/*", "https://music.yandex.ru/*", "https://music.yandex.com/*", "https://music.yandex.kz/*", "https://music.yandex.by/*", "https://music.youtube.com/*"], "js": ["bridge.js"]}
  ]
}
